---
import ProductImage from "@/components/ProductImage.astro";

import {
  confirmedValue,
  hasMeaningfulProductDescription,
  hasDistinctProductSubcategory,
  productDisplayName,
  type Product,
} from "@/data/products";

interface Props {
  product: Product;
  eager?: boolean;
  sizes?: string;
}

const {
  product,
  eager = false,
  sizes = "(min-width: 1280px) 390px, (min-width: 768px) calc((100vw - 112px) / 3), calc(100vw - 48px)",
} = Astro.props;

const displayName = productDisplayName(product);
const showShortDescription = hasMeaningfulProductDescription(
  product,
  product.shortDescription,
);
---

<a
  href={`/products/${product.slug}/`}
  class="group block space-y-4"
  data-product-card
>
  <div class="aspect-[4/5] overflow-hidden rounded-[min(1vw,12px)] bg-paper">
    <ProductImage
      image={product.catalogueImage ?? product.images[0]}
      sizes={sizes}
      loading={eager ? "eager" : "lazy"}
      class="h-full w-full object-cover transition-transform duration-[1200ms] ease-out group-hover:scale-[1.03]"
    />
  </div>

  <div class="flex items-start justify-between gap-4">
    <div>
      <h2 class="text-sm font-medium">{displayName}</h2>
      <p class="text-xs text-faded">SKU: {product.sku}</p>
      {hasDistinctProductSubcategory(product) && (
        <p class="text-xs text-faded">{product.subcategory}</p>
      )}
      {showShortDescription && (
        <p class="text-xs text-faded">{product.shortDescription}</p>
      )}
    </div>

    {confirmedValue(product.material) && (
      <span class="text-xs text-faded">{product.material}</span>
    )}
  </div>
</a>
