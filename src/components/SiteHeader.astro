---
import { siteConfig } from "@/config/site";
const { currentPath = "/" } = Astro.props;

const normalizedPath = currentPath.replace(/\/+$/, "") || "/";

const currentState = (href: string): "page" | "true" | undefined => {
  const normalizedHref = href.replace(/\/+$/, "") || "/";
  if (normalizedPath === normalizedHref) return "page";
  if (normalizedHref === "/catalog" && normalizedPath.startsWith("/products/")) return "true";
  return undefined;
};

const navItems = siteConfig.navigation;
---

<nav class="sticky top-0 z-50 border-b border-line bg-base/80 backdrop-blur-md" aria-label="Main navigation">
  <div class="mx-auto flex h-16 max-w-screen-xl items-center justify-between px-6">

    <a href="/" class="font-serif text-xl italic tracking-tight" aria-label={`${siteConfig.brandName} home`} data-desktop-home>
      {siteConfig.brandName}
    </a>


    <div class="hidden items-center gap-8 text-sm md:flex">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              "transition-colors hover:text-accent",
              currentState(item.href) ? "text-ink" : "text-faded",
            ]}
            aria-current={currentState(item.href)}
          >
            {item.label}
          </a>
        ))
      }
    </div>


    <div class="flex items-center gap-3">

      <button
        type="button"
        class="hidden h-10 w-10 items-center justify-center rounded-full text-ink transition-colors hover:text-accent md:hidden"
        aria-label="Open menu"
        aria-controls="mobile-menu"
        aria-expanded="false"
        data-mobile-menu-open
      >
        <span class="sr-only">Open menu</span>

        <span class="flex w-4 flex-col gap-1.5" aria-hidden="true">
          <span class="h-px w-full bg-current"></span>
          <span class="h-px w-full bg-current"></span>
          <span class="h-px w-full bg-current"></span>
        </span>

      </button>

    </div>

  </div>
  <div class="flex flex-wrap gap-6 px-6 pb-4 text-sm md:hidden" data-mobile-fallback>
    {navItems.map((item) => (
      <a href={item.href} aria-current={currentState(item.href)}>{item.label}</a>
    ))}
  </div>
  <!-- Run while parsing, before first paint: removing this row after paint shifts page content. -->
  <script is:inline>
    if (
      typeof HTMLDialogElement !== "undefined" &&
      typeof HTMLDialogElement.prototype.showModal === "function"
    ) {
      document.querySelector("[data-mobile-fallback]")?.setAttribute("hidden", "");
    }
  </script>
</nav>


<dialog
  id="mobile-menu"
  class="fixed inset-0 m-0 h-dvh max-h-none w-full max-w-none overflow-y-auto border-0 bg-base p-0 text-ink md:hidden"
  aria-label="Mobile menu"
  data-mobile-menu
>

  <div class="flex h-full flex-col px-6 pb-6 pt-5">

    <div class="flex h-11 items-center justify-between">

      <a
        href="/"
        class="font-serif text-xl italic tracking-tight"
        aria-label={`${siteConfig.brandName} home`}
        data-mobile-menu-link
      >
        {siteConfig.brandName}
      </a>


      <button
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center rounded-full text-ink transition-colors hover:text-accent"
        aria-label="Close menu"
        data-mobile-menu-close
      >

        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M6 6l12 12"></path>
          <path d="M18 6L6 18"></path>
        </svg>

      </button>

    </div>


    <div class="flex flex-1 flex-col gap-8 pt-10">


      <div class="space-y-4">

        {
          navItems.map((item) => (
            <a
              href={item.href}
              class:list={[
                "block font-serif text-4xl leading-none transition-colors hover:text-accent",
                currentState(item.href) ? "text-ink" : "text-faded",
              ]}
              aria-current={currentState(item.href)}
              data-mobile-menu-link
            >
              {item.label}
            </a>
          ))
        }

      </div>



      <div class="mt-auto space-y-2 text-sm">

        <p class="text-[10px] uppercase tracking-[0.3em] text-faded">
          Contact
        </p>


        <a
          href={`mailto:${siteConfig.emails.info}`}
          class="block transition-colors hover:text-accent"
          data-mobile-menu-link
        >
          {siteConfig.emails.info}
        </a>

      </div>


    </div>

  </div>

</dialog>



<!-- Native modal dialog keeps keyboard focus and background interaction inside the menu. -->
<script>
  const menu = document.querySelector<HTMLDialogElement>("[data-mobile-menu]");
  const openButton = document.querySelector<HTMLButtonElement>("[data-mobile-menu-open]");
  const closeButton = document.querySelector<HTMLButtonElement>("[data-mobile-menu-close]");
  const fallback = document.querySelector<HTMLElement>("[data-mobile-fallback]");
  if (menu && openButton && closeButton && typeof menu.showModal === "function") {
    const desktop = window.matchMedia("(min-width: 48rem)");
    let previousOverflow = "";
    let previousBodyOverflow = "";
    let locked = false;

    function restorePage() {
      if (!locked) return;
      document.documentElement.style.overflow = previousOverflow;
      document.body.style.overflow = previousBodyOverflow;
      locked = false;
      openButton!.setAttribute("aria-expanded", "false");
      const target = desktop.matches
        ? document.querySelector<HTMLElement>("[data-desktop-home]")
        : openButton;
      target?.focus({ preventScroll: true });
    }

    function closeMenu() {
      if (!menu!.open) return;
      menu!.close();
      restorePage();
    }

    openButton.addEventListener("click", () => {
      if (desktop.matches || menu.open) return;
      previousOverflow = document.documentElement.style.overflow;
      previousBodyOverflow = document.body.style.overflow;
      menu.showModal();
      locked = true;
      document.documentElement.style.overflow = "hidden";
      document.body.style.overflow = "hidden";
      openButton.setAttribute("aria-expanded", "true");
      closeButton.focus({ preventScroll: true });
    });
    closeButton.addEventListener("click", closeMenu);
    menu.addEventListener("cancel", (event) => {
      event.preventDefault();
      closeMenu();
    });
    menu.addEventListener("close", () => {
      if (!menu.open) restorePage();
    });
    menu.addEventListener("keydown", (event) => {
      if (event.key !== "Tab") return;
      const controls = Array.from(menu.querySelectorAll<HTMLElement>("a[href], button:not([disabled])"));
      const first = controls[0];
      const last = controls[controls.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last?.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first?.focus();
      }
    });
    menu.querySelectorAll("[data-mobile-menu-link]").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });
    desktop.addEventListener("change", () => {
      if (desktop.matches) closeMenu();
    });
    // Keep real navigation available until progressive enhancement has initialized.
    if (fallback) fallback.hidden = true;
    openButton.classList.replace("hidden", "inline-flex");
  }
</script>
