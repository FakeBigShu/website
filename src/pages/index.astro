---
import { siteConfig } from "@/config/site";
import ProductBody from "@/components/ProductBody.astro";
import { pageUrl } from "@/utils/urls";
import ProductImage from "@/components/ProductImage.astro";
import ProductCard from "@/components/ProductCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getProducts } from "@/data/products.ts";

const products = await getProducts();
const featured = products.filter((product) => product.featured);
const homepageSelection = ["AS-0005", "GF-0016", "PL-0031", "CS-0064", "AS-0021", "CS-0116"];
const selectedCards = homepageSelection.flatMap((sku) => {
  const product = products.find((product) => product.sku === sku);
  return product ? [product] : [];
});
const featuredCards = [
  ...selectedCards,
  ...products.filter((product) => !homepageSelection.includes(product.sku)),
].slice(0, 6);
const hero = products.find((product) => product.sku === "AS-0005") ?? featured[0];
const solo = featured.find((product) => product.sku === "CS-0019") ?? featured[0];
if (!hero || !solo) {
  throw new Error("The homepage requires a published featured product.");
}
---

<BaseLayout
  title={`${siteConfig.brandName} — ${siteConfig.tagline}`}
  description="Natural stone products, garden sculpture, and custom stone carving for gardens, landscapes, and architectural spaces."
  image={hero.images[0].src}
>
  <main id="main-content">

    <h1 class="sr-only">
      {siteConfig.brandName} — {siteConfig.tagline}
    </h1>


    <!-- ========================================================= -->
    <!-- HERO -->
    <!-- ========================================================= -->

    <section class="relative overflow-hidden bg-base">

      <!-- One prepared image preserves the full product without creating another crop. -->
      <div class="hero-image block aspect-[4/3] w-full bg-paper p-8 md:absolute md:inset-y-0 md:right-0 md:aspect-auto md:w-[56%]">
        <ProductImage
          image={hero.images[0]}
          sizes="(min-width: 768px) 56vw, 100vw"
          loading="eager"
          fetchpriority="high"
          class="h-full w-full object-contain object-center"
        />
      </div>

      <!-- Mobile Hero content -->
      <div class="md:hidden">

        <div class="space-y-6 px-6 py-12">

          <p
            class="flex items-center gap-3 text-[11px] uppercase tracking-[0.3em] text-faded"
          >
            <span class="inline-block h-px w-8 bg-ink/40"></span>
            Quyang, China · Stone Craftsmanship
          </p>

          <p
            class="text-balance font-serif text-4xl leading-[0.95]"
          >
            Natural stone
            <br />
            <span class="italic text-accent">
              for thoughtful spaces.
            </span>
          </p>

          <p
            class="max-w-[48ch] text-pretty leading-relaxed text-faded"
          >
            A curated collection of natural stone pieces for gardens,
            landscapes, architectural spaces, and bespoke projects.
          </p>

          <div
            class="flex flex-col items-start gap-4 pt-2 sm:flex-row sm:items-center"
          >

            <a
              href="/catalog/"
              class="group inline-flex items-center gap-3 rounded-full bg-ink px-7 py-4 text-[11px] font-medium uppercase tracking-[0.2em] text-[var(--color-base)] transition-colors hover:bg-accent"
            >
              Explore Collections

              <span
                aria-hidden="true"
                class="transition-transform group-hover:translate-x-1"
              >
                →
              </span>
            </a>

            <a
              href="/about/"
              class="text-[11px] uppercase tracking-[0.2em] text-faded transition-colors hover:text-ink"
            >
              About Lumavia →
            </a>

          </div>

        </div>

      </div>


      <!-- ========================================================= -->
      <!-- DESKTOP HERO -->
      <!-- ========================================================= -->

      <div
        class="relative hidden h-[88vh] max-h-[920px] min-h-[640px] w-full md:block"
      >

        <!-- Content container -->

        <div
          class="hero-content relative flex h-full w-[44%] items-center px-6"
        >

          <div class="max-w-[480px] space-y-8">

            <p
              class="flex items-center gap-3 text-[11px] uppercase tracking-[0.3em] text-faded"
            >
              <span class="inline-block h-px w-8 bg-ink/40"></span>

              Quyang, China · Stone Craftsmanship
            </p>


            <p
              class="text-balance font-serif text-5xl leading-[0.95] lg:text-6xl"
            >
              Natural stone
              <br />

              <span class="italic text-accent">
                for thoughtful spaces.
              </span>
            </p>


            <p
              class="max-w-[48ch] text-pretty leading-relaxed text-faded md:text-lg"
            >
              A curated collection of natural stone pieces for gardens,
              landscapes, architectural spaces, and bespoke projects.
            </p>


            <div class="flex flex-col items-start gap-4 pt-2 xl:flex-row xl:items-center xl:gap-6">

              <a
                href="/catalog/"
                class="group inline-flex items-center gap-3 rounded-full bg-ink px-7 py-4 text-[11px] font-medium uppercase tracking-[0.2em] text-[var(--color-base)] transition-colors hover:bg-accent"
              >
                Explore Collections

                <span
                  aria-hidden="true"
                  class="transition-transform group-hover:translate-x-1"
                >
                  →
                </span>
              </a>


              <a
                href="/about/"
                class="text-[11px] uppercase tracking-[0.2em] text-faded transition-colors hover:text-ink"
              >
                About Lumavia →
              </a>

            </div>

          </div>

        </div>


        <!-- Product label -->

        <div
          class="absolute bottom-10 right-10 hidden flex-col items-end gap-1 text-[10px] uppercase tracking-[0.3em] text-ink/70 md:flex"
        >

          <span>
            {hero.name}
          </span>

          <span class="text-faded">
            {hero.category}
          </span>

        </div>

      </div>

    </section>


    <!-- ========================================================= -->
    <!-- FEATURED PRODUCTS -->
    <!-- ========================================================= -->

    <section
      class="mx-auto max-w-screen-xl px-6 pt-24 md:pt-32"
    >

      <div
        class="mb-12 flex items-end justify-between gap-6 border-t border-line pt-10"
      >

        <div>

          <p
            class="mb-4 text-[11px] uppercase tracking-[0.3em] text-faded"
          >
            Selected stone pieces
          </p>


          <h2
            class="max-w-[20ch] text-balance font-serif text-3xl md:text-5xl"
          >
            A considered collection,

            <span class="italic text-accent">
              crafted in stone.
            </span>
          </h2>

        </div>


        <a
          href="/catalog/"
          class="hidden items-center gap-2 whitespace-nowrap text-[11px] uppercase tracking-[0.2em] text-faded transition-colors hover:text-ink md:inline-flex"
        >
          View all

          <span aria-hidden="true">
            →
          </span>
        </a>

      </div>


      <div
        class="grid grid-cols-1 gap-x-8 gap-y-12 md:grid-cols-3"
      >

        {featuredCards.map((product) => (
          <ProductCard product={product} />
        ))}

      </div>


      <div class="mt-10 flex justify-center md:hidden">

        <a
          href="/catalog/"
          class="inline-flex items-center gap-2 text-[11px] uppercase tracking-[0.2em] text-faded transition-colors hover:text-ink"
        >
          View all collections →
        </a>

      </div>

    </section>


    <!-- ========================================================= -->
    <!-- SOLO PRODUCT -->
    <!-- ========================================================= -->

    <section class="mt-32 md:mt-48">

      <div class="mx-auto max-w-screen-2xl px-6">

        <div
          class="grid items-center gap-10 md:grid-cols-12 md:gap-16"
        >

          <div class="md:col-span-7 lg:col-span-8">

            <a
              href={`/products/${solo.slug}/`}
              class="group block aspect-[5/4] overflow-hidden rounded-[min(1vw,16px)] bg-paper md:aspect-[16/11]"
            >

              <ProductImage
                image={solo.images[0]}
                sizes="(min-width: 1536px) 960px, (min-width: 1024px) calc((100vw - 112px) * 2 / 3), (min-width: 768px) calc((100vw - 112px) * 7 / 12), calc(100vw - 48px)"
                loading="lazy"
                class="h-full w-full object-contain transition-transform duration-[1400ms] ease-out group-hover:scale-[1.02]"
              />

            </a>

          </div>


          <div class="space-y-6 md:col-span-5 lg:col-span-4">

            <p
              class="flex items-center gap-3 text-[11px] uppercase tracking-[0.3em] text-faded"
            >

              <span class="inline-block h-px w-8 bg-ink/40"></span>

              {solo.category}

            </p>


            <h2
              class="text-balance font-serif text-4xl leading-[1.02] md:text-5xl"
            >
              {solo.name}
            </h2>


            <ProductBody product={solo} class="text-pretty leading-relaxed text-faded" />


            <dl
              class="grid grid-cols-2 gap-x-6 gap-y-3 border-t border-line pt-2 text-xs"
            >

              <dt
                class="pt-3 uppercase tracking-[0.2em] text-faded"
              >
                SKU
              </dt>

              <dd class="pt-3">
                {solo.sku}
              </dd>


              <dt
                class="uppercase tracking-[0.2em] text-faded"
              >
                Category
              </dt>

              <dd>
                {solo.category}
              </dd>



            </dl>


            <a
              href={`/products/${solo.slug}/`}
              class="inline-flex items-center gap-3 rounded-full bg-ink px-6 py-3.5 text-[11px] font-medium uppercase tracking-[0.2em] text-[var(--color-base)] transition-colors hover:bg-accent"
            >
              View the detail →
            </a>

          </div>

        </div>

      </div>

    </section>


    <!-- ========================================================= -->
    <!-- FEATURES -->
    <!-- ========================================================= -->

    <section
      class="mx-auto mt-32 max-w-screen-xl px-6 md:mt-48"
    >

      <div class="border-t border-line pt-12">

        <p
          class="mb-4 text-[11px] uppercase tracking-[0.3em] text-faded"
        >
          Our stone
        </p>


        <h2
          class="mb-12 max-w-[22ch] text-balance font-serif text-3xl md:text-5xl"
        >
          Selected for

          <span class="italic text-accent">
            character and permanence.
          </span>
        </h2>


        <div
          class="grid gap-x-8 gap-y-10 md:grid-cols-3"
        >

          {
            [
              {
                name: "Natural Stone",
                tag: "Timeless · tactile",
                copy:
                  "Natural stone brings weight, texture, and individuality to every piece. Each surface carries its own character.",
              },
              {
                name: "Quyang Craftsmanship",
                tag: "Skilled · enduring",
                copy:
                  "Rooted in Quyang's long tradition of stone carving, our work combines traditional craftsmanship with contemporary forms.",
              },
              {
                name: "Made for Projects",
                tag: "Flexible · considered",
                copy:
                  "From individual garden pieces to larger landscape projects, we develop products around practical requirements and design intent.",
              },
            ].map((material) => (
              <div class="space-y-3 pt-2">

                <p
                  class="text-[10px] uppercase tracking-[0.3em] text-faded"
                >
                  {material.tag}
                </p>


                <h3 class="font-serif text-2xl">
                  {material.name}
                </h3>


                <p
                  class="text-sm leading-relaxed text-faded"
                >
                  {material.copy}
                </p>

              </div>
            ))
          }

        </div>

      </div>

    </section>


    <!-- ========================================================= -->
    <!-- STRUCTURED DATA -->
    <!-- ========================================================= -->

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Organization",
        name: siteConfig.brandName,
        url: pageUrl("/", Astro.site ?? siteConfig.siteUrl).href,
        slogan: siteConfig.tagline,
        address: {
          "@type": "PostalAddress",
          addressRegion: "Hebei",
          addressCountry: "CN",
        },
      })}
    ></script>


  </main>
</BaseLayout>

<style>
  @media (min-width: 768px) {
    .hero-image { padding: clamp(64px, 9vh, 96px) clamp(24px, 4vw, 80px); }
    .hero-content { padding-left: clamp(24px, 4.8vw, 96px); padding-right: clamp(24px, 3vw, 56px); }
  }
</style>
