---
import { siteConfig } from "@/config/site";
import { getProducts } from "@/data/products";
import BaseLayout from "@/layouts/BaseLayout.astro";
const products = await getProducts();
const inquiryProducts = products.map(({ name, slug, sku }) => ({ name, slug, sku }));
const socialProduct = products.find(({ sku }) => sku === "GF-0001");
---

<BaseLayout
  title={`About — ${siteConfig.brandName}`}
  description={`${siteConfig.brandName} is a Quyang-based natural stone sourcing and product supply brand for international buyers, with a focus on garden, landscape and architectural products.`}
  image={socialProduct?.images[0].src}
  imageAlt={socialProduct ? `${siteConfig.brandName} product: ${socialProduct.name}` : undefined}
>
  <main id="main-content">

    <section class="mx-auto max-w-screen-xl px-6 pb-16 pt-20 md:pb-24 md:pt-28">

      <p class="mb-6 flex items-center gap-3 text-[11px] uppercase tracking-[0.3em] text-faded">
        <span class="inline-block h-px w-8 bg-ink/40"></span>
        About {siteConfig.brandName}
      </p>

      <h1 class="max-w-[18ch] text-balance font-serif text-5xl leading-[0.95] md:text-7xl">
        Natural stone,
        <span class="italic text-accent">crafted with purpose.</span>
      </h1>

      <p class="mt-8 max-w-[58ch] text-lg leading-relaxed text-faded">
        {siteConfig.brandName} is a Quyang-based natural stone sourcing and product
        supply brand. We source and present products for international buyers,
        with a focus on gardens, landscapes, and architectural settings.
      </p>

    </section>


    <section class="mx-auto mt-12 grid max-w-screen-xl gap-10 px-6 md:mt-16 md:grid-cols-12 md:gap-16">

      <div class="md:col-span-5">

        <p class="mb-6 text-[11px] uppercase tracking-[0.3em] text-faded">
          Quyang · Hebei · China
        </p>

        <h2 class="text-balance font-serif text-3xl leading-[1.02] md:text-5xl">
          Sourcing from Quyang.
        </h2>

      </div>


      <div class="space-y-6 leading-relaxed text-faded md:col-span-6 md:col-start-7">

        <p>
          Based in Quyang, Hebei, China, we work with local suppliers and
          workshops in a region known for its stone-carving tradition.
        </p>

        <p>
          Our focus is product selection and supply enquiries. We present
          available product information and discuss individual requirements
          with suppliers and international buyers.
        </p>

      </div>

    </section>


    <section class="mx-auto mt-24 max-w-screen-xl border-t border-line px-6 pt-12 md:mt-32">

      <p class="mb-12 text-[11px] uppercase tracking-[0.3em] text-faded">
        How we work
      </p>

      <div class="grid gap-x-8 gap-y-12 md:grid-cols-3">

        {
          [
            {
              n: "01",
              h: "Product selection",
              p: "We source and present natural stone products through local suppliers and workshops, with a focus on garden, landscape, and architectural product directions.",
            },
            {
              n: "02",
              h: "Product information",
              p: "Material, dimensions, finish, and other specifications need to be confirmed for individual products and enquiries.",
            },
            {
              n: "03",
              h: "Custom enquiries",
              p: "Custom enquiries are reviewed case by case. Feasibility depends on the product, dimensions, stone, supplier capability, and project requirements.",
            },
          ].map((block) => (
            <div class="space-y-3">

              <p class="text-[10px] uppercase tracking-[0.3em] text-faded tabular-nums">
                {block.n}
              </p>

              <h3 class="font-serif text-2xl">
                {block.h}
              </h3>

              <p class="text-sm leading-relaxed text-faded">
                {block.p}
              </p>

            </div>
          ))
        }

      </div>

    </section>


    <section class="mt-24 md:mt-32">

      <div class="mx-auto grid max-w-screen-xl gap-10 px-6 md:grid-cols-12 md:gap-16">

        <div class="space-y-8 md:col-span-8 md:col-start-3">

          <p class="flex items-center gap-3 text-[11px] uppercase tracking-[0.3em] text-faded">

            <span class="inline-block h-px w-8 bg-ink/40"></span>

            On stone

          </p>


          <blockquote class="text-balance font-serif text-3xl leading-[1.15] md:text-4xl">

            "We look to stone's form, texture, and character
            <span class="italic text-accent">
              as a starting point for product selection.
            </span>"

          </blockquote>


          <p class="text-xs uppercase tracking-[0.25em] text-faded">
            — {siteConfig.brandName}
          </p>


          <div class="space-y-3 border-t border-line pt-6 text-sm leading-relaxed text-faded">

            <p>
              The current catalogue presents planters, garden fountains,
              spheres, animal statues, and stone benches.
            </p>

          </div>

        </div>

      </div>

    </section>


    <section class="mx-auto mt-24 max-w-screen-xl border-y border-line px-6 py-12 md:mt-32">

      <div class="space-y-2 text-center">
        <p class="font-serif text-4xl tabular-nums md:text-5xl">
          {String(products.length).padStart(2, "0")}
        </p>
        <p class="text-[10px] uppercase tracking-[0.3em] text-faded">
          Products in the Catalogue
        </p>
      </div>

    </section>


    <section id="studio" data-inquiry-products={JSON.stringify(inquiryProducts)} class="mx-auto mb-32 mt-12 max-w-screen-xl px-6 md:mt-16">

      <div class="grid items-end gap-10 md:grid-cols-12">

        <div class="md:col-span-7">

          <h2 class="max-w-[20ch] text-balance font-serif text-3xl leading-[1.02] md:text-5xl">
            Explore our collections,
            or discuss a custom requirement.
          </h2>
          <p class="mt-4 max-w-[48ch] text-sm leading-relaxed text-faded">
            Custom feasibility and specifications are confirmed case by case.
          </p>
          <p hidden data-inquiry-summary class="mt-4 text-sm text-faded" aria-live="polite"></p>

        </div>


        <div class="flex flex-col gap-4 sm:flex-row md:col-span-5 md:justify-end">

          <a
            href="/catalog/"
            class="inline-flex items-center justify-center gap-3 rounded-full bg-ink px-7 py-4 text-[11px] font-medium uppercase tracking-[0.2em] text-[var(--color-base)] transition-colors hover:bg-accent"
          >
            Explore the Catalogue →
          </a>

          <a
            data-inquiry-email
            href={`mailto:${siteConfig.emails.studio}`}
            class="inline-flex items-center justify-center gap-3 rounded-full px-7 py-4 text-[11px] font-medium uppercase tracking-[0.2em] text-ink ring-1 ring-line transition-colors hover:bg-paper"
          >
            Contact Lumavia
          </a>

        </div>

      </div>

    </section>

    <script>
      const contact = document.querySelector<HTMLElement>("[data-inquiry-products]");
      const summary = contact?.querySelector<HTMLElement>("[data-inquiry-summary]");
      const email = contact?.querySelector<HTMLAnchorElement>("[data-inquiry-email]");
      if (contact && summary && email) {
        const products: { name: string; slug: string; sku: string }[] = JSON.parse(contact.dataset.inquiryProducts || "[]");
        const slug = new URLSearchParams(window.location.search).get("slug");
        // Resolve against published products instead of trusting a URL-supplied name.
        const product = products.find((item) => item.slug === slug);
        if (product) {
          summary.textContent = `Inquiry about: ${product.name}`;
          summary.hidden = false;
          const params = new URLSearchParams({
            subject: `Request a Quote: ${product.name}`,
            body: `Product Name: ${product.name}\nSKU: ${product.sku}\nProduct Slug: ${product.slug}\n\nPlease share your quantity, destination, and project requirements:\n`,
          });
          email.href = `${email.getAttribute("href")}?${params.toString().replace(/\+/g, "%20")}`;
        }
      }
    </script>
  </main>
</BaseLayout>
